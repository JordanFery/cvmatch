# NOTE ON NAMING: none of the variables below use the NEXT_PUBLIC_ prefix,
# even though six of them (Supabase URL/anon key, site URL, GA id, support
# email, legal entity name) are genuinely meant to reach the browser. This
# project's Vercel team blocks saving any env var named with a public
# framework prefix at all — so instead, next.config.ts's `env` field reads
# these plain names and re-exposes them under the NEXT_PUBLIC_ name the
# app code expects, inlined into the JS bundle at build time exactly like
# a real NEXT_PUBLIC_ var would be. If your hosting doesn't have that
# restriction, these still work identically either way — nothing else
# changes. See the comment in next.config.ts for the full explanation.

# --- Supabase ---
# Project settings > API in your Supabase dashboard.
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# --- Database (Prisma) ---
# Project settings > Database > Connection string in your Supabase dashboard.
# DATABASE_URL: pooled connection (port 6543, pgbouncer) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used by Prisma Migrate only.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- App ---
# Base URL of this app, used to build absolute redirect/callback URLs
# (email confirmation, password reset). No trailing slash. Set this to your
# real production domain in your hosting platform's env vars (e.g. Vercel) —
# leaving it as localhost in production breaks auth email links.
SITE_URL="http://localhost:3000"
# Google Analytics measurement id. Optional — GA is simply not loaded if unset.
GA_ID=""
# Shown on /contact and /privacy. Optional — defaults to the real support
# address (see src/lib/legal/site.ts) if unset; override per-environment if needed.
SUPPORT_EMAIL="support@yourdomain.com"
# Your real registered business name (or your own legal name, if operating
# as an individual), shown in /privacy and /terms. Optional — defaults to
# the real value in src/lib/legal/site.ts if unset.
LEGAL_ENTITY_NAME="Your Legal Entity Name Inc."
# Optional — a Slack or Discord "incoming webhook" URL. When set, unexpected
# server/AI/Stripe-webhook errors also POST a short alert here (in addition
# to the normal server logs), so a human actually notices them. Leave unset
# to keep today's console-only logging.
ALERT_WEBHOOK_URL=""

# --- Anthropic (Claude) ---
# Used server-side only (src/lib/cv/parse-with-llm.ts) to structure CV text
# after upload. Never exposed to the browser. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Stripe ---
# dashboard.stripe.com/apikeys (use test-mode keys until you're ready to charge real cards).
STRIPE_SECRET_KEY="sk_test_..."
# dashboard.stripe.com/webhooks — create an endpoint pointing to
# <your-domain>/api/webhooks/stripe listening for: customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid.
# For local dev, use the Stripe CLI instead: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# (it prints a webhook secret starting with whsec_ for that session).
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for the two paid plans (src/lib/billing/plans.ts) — create the
# products/prices in the Stripe Dashboard (or via the API) and paste their IDs here.
STRIPE_PRICE_ESSENTIAL="price_..."
STRIPE_PRICE_PRO="price_..."
